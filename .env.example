# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed vars.
#
# Both of these end up in the built JavaScript, which is expected: the anon
# key is a public identifier, not a secret. What stops it being abused is
# that every battle mutation goes through a token-validated RPC rather than
# writing to tables directly.

VITE_SUPABASE_URL=https://sfzaadnpkqgsdzidhqie.supabase.co
VITE_SUPABASE_ANON_KEY=

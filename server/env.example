# CloudKit Configuration
# IMPORTANT: Replace these with your actual values and NEVER commit the real .env file

# Your CloudKit container identifier
CK_CONTAINER=iCloud.AuraBrand.TuneBoxed

# Environment (development or production)
CK_ENV=development

# Database type (public, private, or shared - server-to-server only supports public)
CK_DB=public

# Your CloudKit Key ID (from CloudKit Dashboard)
CK_KEY_ID=your_key_id_here

# Your EC private key in PEM format (from CloudKit Dashboard)
CK_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----
your_private_key_here
-----END EC PRIVATE KEY-----

# Server Configuration
PORT=3001
NODE_ENV=development 